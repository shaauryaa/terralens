# --- Secrets (never commit) ---
.env
.env.*
!.env.example

# --- Project data and artifacts (never commit) ---
# data/raw/, data/interim/ and data/external/ are ignored except for their README / .gitkeep.
data/raw/*
data/interim/*
data/processed/*
data/external/*
!data/raw/.gitkeep
!data/raw/README.md
!data/interim/.gitkeep
!data/processed/.gitkeep
!data/processed/README.md
!data/external/.gitkeep
!data/external/README.md
outputs/

# --- Model checkpoints and weights (never commit) ---
# Root-level only, so src/terralens/models/ (code) is not ignored.
/models/
/checkpoints/
checkpoint-*/
runs/
wandb/
*.safetensors
*.bin
*.pt
*.pth
*.ckpt
*.gguf
*.onnx

# --- Claude Code (per-user) ---
.claude/settings.local.json

# --- Python ---
__pycache__/
*.py[cod]
*$py.class
*.so
build/
dist/
*.egg-info/
.eggs/
.venv/
venv/
env/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/
.ipynb_checkpoints/

# --- Editors / OS ---
.vscode/
.idea/
.DS_Store
Thumbs.db

# --- Prediction files (ids + labels + logits; kept locally, not committed) ---
results/predictions/

# --- Generated data sets (challenge set is data) ---
data/challenge/*
!data/challenge/.gitkeep
